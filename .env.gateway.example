# R-Agent Gateway example config
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

RAGENT_GATEWAY_HOST=0.0.0.0
RAGENT_GATEWAY_PORT=8080
RAGENT_GATEWAY_AUTH_TOKEN=change-me
RAGENT_GATEWAY_MAX_SESSIONS=100

# If true, Feishu webhook returns 202 immediately and processes the message in a background worker.
RAGENT_GATEWAY_ASYNC_WEBHOOKS=false
RAGENT_GATEWAY_ASYNC_QUEUE_SIZE=100
RAGENT_GATEWAY_ASYNC_WORKERS=1
RAGENT_GATEWAY_EVENT_DEDUPE_TTL_SECONDS=3600

# WeChat Official Account / XML-compatible callback
WECHAT_TOKEN=

# Feishu/Lark bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Encrypted callbacks are documented as unsupported in this minimal gateway.
FEISHU_ENCRYPT_KEY=

# QQ Official Bot webhook
QQ_APP_ID=
QQ_APP_SECRET=
QQ_SANDBOX=false
