# 1. 客户端类型 (openai 或 azure)
LLM_CLIENT_TYPE="openai"

# 2. 你的 API 密钥
OPENAI_API_KEY="YOUR_API_KEY_HERE"

# 3. Azure 模式下，这里必须填写 AIDP 平台上的“接入点(Endpoint)名称”，例如 ep-2024xxxx-xxx
# 如果是 OpenAI 模式，这里填写模型名称，如 gpt-4o
LLM_MODEL="ep-xxxxxxxx-xxxxx"

# 4. Azure 端点与版本 (默认已配好，不用改)
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_VERSION="2024-02-01"

# 5. OpenAI 第三方代理 Base URL (可选)
OPENAI_BASE_URL="https://api.deepseek.com/v1"

# 6. Web Search provider（可选）
# Google 官方 Programmable Search JSON API：
# 1) 在 Google Cloud 启用 Custom Search API 并创建 API Key；
# 2) 在 Programmable Search Engine 创建搜索引擎并获取 Search engine ID（cx）。
# 配置后 web_search(provider="google_cse") 可直接使用；auto 模式会在 Bing 后尝试它。
# GOOGLE_SEARCH_API_KEY="YOUR_GOOGLE_API_KEY"
# GOOGLE_SEARCH_ENGINE_ID="YOUR_PROGRAMMABLE_SEARCH_ENGINE_ID"
#
# 其它可选 provider：
# SERPER_API_KEY="YOUR_SERPER_API_KEY"
# GROUNDROUTE_API_KEY="YOUR_GROUNDROUTE_API_KEY"
# WEB_SEARCH_PROVIDER_ORDER="bing,google_cse,groundroute,serper,yahoo,duckduckgo"
# WEB_SEARCH_LOCAL_HTML_ORDER="bing,yahoo,duckduckgo"
# WEB_SEARCH_API_TIMEOUT=20

# 7. /bbb 终端语音输入转写配置（可选）
# 默认使用在线 OpenAI/Azure 兼容 Audio Transcriptions 接口；如需本地免费转写，可启用 whisper.cpp。
# 可选值：online/openai/azure/whispercpp；本项目建议启用本地 whisper.cpp，避免在线语音转写费用
VOICE_INPUT_STT_BACKEND="whispercpp"
VOICE_INPUT_STT_MODEL="whisper-1"
VOICE_INPUT_LANGUAGE="zh"
VOICE_INPUT_STT_TIMEOUT="120"
# 如果主 OPENAI_BASE_URL 不支持音频转写，可单独指定语音转写服务
# VOICE_INPUT_BASE_URL="https://api.openai.com/v1"
# VOICE_INPUT_API_KEY="YOUR_VOICE_API_KEY_HERE"
# 本地 whisper.cpp 后端：先安装 whisper.cpp，再下载模型到 models/whisper.cpp/ggml-base.bin
# Homebrew 安装时通常可以直接使用 whisper-cli；也可改成 /opt/homebrew/bin/whisper-cli 等绝对路径
VOICE_INPUT_WHISPERCPP_BIN="whisper-cli"
VOICE_INPUT_WHISPERCPP_MODEL="models/whisper.cpp/ggml-base.bin"
VOICE_INPUT_WHISPERCPP_THREADS="4"
VOICE_INPUT_WHISPERCPP_EXTRA_ARGS=""
# 可选：使用 ffmpeg 后端时指定录音设备；macOS avfoundation 常见默认值为 :0，Linux ALSA 常见默认值为 default
# VOICE_INPUT_FFMPEG_DEVICE=":0"

DISPLAY_MODE="concise"

# 关闭自动后台 self-evolution review
SELF_EVOLUTION_REVIEW_INTERVAL=0

# 延迟工具暴露：只常驻日常工具，把体量大的专用工具（AutoResearch 套件、语音、
# skill 管理、artifact 切片等）藏进目录，模型用 tool_search 按需提升。
# 实测把工具定义从 ≈9070 tok 降到 ≈4270 tok（省约 53%）。
DEFERRED_TOOLS_ENABLED=1

# Per-session sandbox：Todo、普通 file tools、GUI 文件面板、run events、
# 大工具输出与 delegate context 统一落到 sandbox/sessions/<session_id>/。
SESSION_SANDBOX_ENABLED=1

# 工具结果注入防护灰度：audit 只记录疑似命中，不改写工具结果。
# 观察误报后可改为 enforce；设为 off 关闭。
TOOL_SANITIZATION_MODE="audit"

# Durable context：每次模型请求临时注入 summary/delegation/skill/memory，
# 不写入 messages 历史；memory 以隐藏 user 数据段注入，避免获得 system 权限。
DURABLE_CONTEXT_ENABLED=1
MEMORY_INJECTION_MODE="hidden_user"

# Structured DeerMem：JSONL facts + 压缩时自动抽取 + session 情节记忆 + 自动治理。
MEMORY_PROVIDER="deermem"
MEMORY_WRITE_MIDDLEWARE_ENABLED=1
MEMORY_SESSION_FACTS_ENABLED=1
MEMORY_SESSION_FACT_CONFIDENCE_THRESHOLD=0.3
MEMORY_SESSION_MAX_FACTS=100

# Fact 准入 / 注入预算。
MEMORY_MAX_FACTS=200
MEMORY_FACT_CONFIDENCE_THRESHOLD=0.5
MEMORY_MAX_INJECTION_TOKENS=2000
MEMORY_GUARANTEED_CATEGORIES="correction"
MEMORY_GUARANTEED_TOKEN_BUDGET=500

# 自动治理：仅当距上次整理至少 3 天且存在新增 durable fact 时运行。
MEMORY_STALENESS_ENABLED=1
MEMORY_CONSOLIDATION_ENABLED=1
MEMORY_GOVERNANCE_INTERVAL_DAYS=3
MEMORY_STALENESS_AGE_DAYS=90
MEMORY_STALENESS_MAX_REMOVALS_PER_CYCLE=10
MEMORY_STALENESS_PROTECTED_CATEGORIES="correction"
MEMORY_STALENESS_MAX_EXTENSION_DAYS=3650
MEMORY_STALENESS_MAX_LIFETIME_MULTIPLIER=20
MEMORY_CONSOLIDATION_MIN_FACTS=8
MEMORY_CONSOLIDATION_MAX_GROUPS_PER_CYCLE=3
MEMORY_CONSOLIDATION_MAX_SOURCES=8
