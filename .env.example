# 1. 客户端类型 (openai 或 azure)
LLM_CLIENT_TYPE="openai"

# 2. 你的 API 密钥
OPENAI_API_KEY="YOUR_API_KEY_HERE"

# 3. Azure 模式下，这里必须填写 AIDP 平台上的“接入点(Endpoint)名称”，例如 ep-2024xxxx-xxx
# 如果是 OpenAI 模式，这里填写模型名称，如 gpt-4o
LLM_MODEL="ep-xxxxxxxx-xxxxx"

# 4. Azure 端点与版本 (默认已配好，不用改)
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_VERSION="2024-02-01"

# 5. OpenAI 第三方代理 Base URL (可选)
OPENAI_BASE_URL="https://api.deepseek.com/v1"

# 6. /bbb 终端语音输入转写配置（可选）
# 默认使用在线 OpenAI/Azure 兼容 Audio Transcriptions 接口；如需本地免费转写，可启用 whisper.cpp。
# 可选值：online/openai/azure/whispercpp；本项目建议启用本地 whisper.cpp，避免在线语音转写费用
VOICE_INPUT_STT_BACKEND="whispercpp"
VOICE_INPUT_STT_MODEL="whisper-1"
VOICE_INPUT_LANGUAGE="zh"
VOICE_INPUT_STT_TIMEOUT="120"
# 如果主 OPENAI_BASE_URL 不支持音频转写，可单独指定语音转写服务
# VOICE_INPUT_BASE_URL="https://api.openai.com/v1"
# VOICE_INPUT_API_KEY="YOUR_VOICE_API_KEY_HERE"
# 本地 whisper.cpp 后端：先安装 whisper.cpp，再下载模型到 models/whisper.cpp/ggml-base.bin
# Homebrew 安装时通常可以直接使用 whisper-cli；也可改成 /opt/homebrew/bin/whisper-cli 等绝对路径
VOICE_INPUT_WHISPERCPP_BIN="whisper-cli"
VOICE_INPUT_WHISPERCPP_MODEL="models/whisper.cpp/ggml-base.bin"
VOICE_INPUT_WHISPERCPP_THREADS="4"
VOICE_INPUT_WHISPERCPP_EXTRA_ARGS=""
# 可选：使用 ffmpeg 后端时指定录音设备；macOS avfoundation 常见默认值为 :0，Linux ALSA 常见默认值为 default
# VOICE_INPUT_FFMPEG_DEVICE=":0"
